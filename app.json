{
  "expo": {
    "name": "HealthMate",
    "slug": "healthmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthmate.app"
    },
    "android": {
      "package": "com.rashini.healthmate",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E88E5"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      "expo-font"
    ]
  }
}
